# Copy to .env and fill in only the provider(s) you configured in
# scenepipe.config.json's `voice` block. Nothing here is required —
# macos-say (the default) needs none of these.

# ElevenLabs — https://elevenlabs.io
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Sarvam AI — https://docs.sarvam.ai
SARVAM_API_KEY=

# Azure Speech — https://learn.microsoft.com/azure/ai-services/speech-service
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Google Cloud Text-to-Speech — https://cloud.google.com/text-to-speech
GOOGLE_TTS_API_KEY=
